// Challenge 8: Alternate Day Sales Tracker (Index-Based Traversal)
/*Industry Context: Marketing team check karna chahti hai ki alternate days (ek din chhodkar ek din, jaise Day 0, Day 2, Day 4...) par total kitni sales ho rahi hai, taaki woh specific pattern samajh sakein. Tumhe loop ko ek-ek karke badhane ke bajaye alternate steps par chalana hai.

Input: [10, 20, 30, 40, 50, 60]

Expected Output: 90 (Kyunki index 0, 2, aur 4 ka sum: 10 + 30 + 50 = 90)

Hint: Loop ke step increment i++ par dhyan do, wahan kuch badalna padega!
*/

function alternateDaySalesTracker(arr){
  let total = 0;
  for(let i =0; i < arr.length; i+=2){
    total += arr[i]
  }
  return total
}
console.log(alternateDaySalesTracker([10, 20, 30, 40, 50, 60]))

