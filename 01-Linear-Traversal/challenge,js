/*
Industry Context: E-commerce apparel shop par ek offer chal raha hai: Cart mein jitne bhi kapde hain, unmein se sirf unhi kapdon ka total bill banao jinki price 300 se zyada hai. Jo kapde 300 ya usse kam ke hain, unhe offers ke tehat free/skip kar do!

Input: [500, 150, 1200, 300, 450]

Expected Output: 2150 (Kyunki 500 + 1200 + 450 = 2150, aur 150 aur 300 ko skip kar diya gaya)

Constraint: Pure for-loop aur if condition ka use karo accumulator ke sath.
*/


function genTotalBill(arr){
  let totalBill = 0;

  for(let i = 0 ; i < arr.length; i++){
    if(arr[i] > 300) totalBill+=arr[i];
  }

  return {
    finalAmount: totalBill,
  }
}

console.log(genTotalBill([500, 150, 1200, 300, 450]));

