// Website analytics ka data hai. Har ghante website par kitne users active the, uska data hai. Tumhe poore din ka Maximum Active Users dhoodhna hai aur yeh batana hai ki woh kis ghante (index) par aaya.

function getAvtiveUser(arr){
  let max = arr[0];
  let userIndex = 0
   for(let i = 0 ; i < arr.length; i ++){
     if(arr[i] > max) {
       max = arr[i] ;
     userIndex = i
    } 
   };
  return {
    maxActiveUser : max,
    userPosition:userIndex
    }
}

console.log(getAvtiveUser([120, 450, 900, 850, 300]));



