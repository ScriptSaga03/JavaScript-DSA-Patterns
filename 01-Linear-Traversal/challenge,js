// Problem 2
function totalAmount(arr){
  let total = 0;
  for(let i = 0; i < arr.length ; i++){
   total += arr[i]
  }
  return {
    totalBill: total,
    isFreeShipping : total > 500,
    
  };
  
}

console.log(totalAmount([120, 80, 250, 90, 110]));

function discountTotal (arr){
  return arr.reduce((acc, curr) =>{
    acc.totalAmount += curr;
    acc.isFreeShipping = acc.totalAmount > 500;

    return acc;
    
  }, {totalAmount:0, isFreeShipping: false});
}
console.log(discountTotal([120, 110]));
console.log(discountTotal([120, 80, 250, 90, 110]));



