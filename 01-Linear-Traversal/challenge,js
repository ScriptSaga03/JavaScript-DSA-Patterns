// Tum ek apparel website ka Inventory Management Dashboard bana rahe ho. Tumhare paas ek array hai jismein alag-alag clothes ka stock count store hai (jaise [45, 12, 0, 89, 4, 0]). Management chahti hai ki jaise hi inventory mein pehla aisa item mile jiska stock 0 (Out of stock) ho chuka hai, tum turant us item ka index return kar do taaki vendor ko auto-alert chala jaye.


let inventory = [12, 5, 8, 0, 14, 0];
function hasStock(arr,target){
  for(let i = 0; i < arr.length; i++ ){
    if(arr[i] === target){
      return i;
    }
  }
  return -1
};
console.log(hasStock(inventory, 0));

